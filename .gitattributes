# Tiny Tapeout hardening and provenance are produced on Linux. Keep all
# authoritative text inputs byte-stable across Windows and Linux clones.
*         text=auto eol=lf
*.v       text eol=lf
*.sv      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
Makefile  text eol=lf

*.gds     binary
*.png     binary
*.fst     binary
*.vcd     binary

# Language stats. This is a hardware design, but the cocotb simulation harness
# and helper tooling outweigh the RTL by byte count, so GitHub was reporting the
# repository as Python. Exclude the harness and tooling from the language bar so
# the RTL identifies the project. The Tiny Tapeout cocotb tests under test/ stay
# detectable, which keeps the Python verification work visible.
"Game Simulation/**/*.py" linguist-vendored=true
tools/**/*.py             linguist-vendored=true
